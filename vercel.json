{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": { "includeFiles": "Frontend/extracted/**" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.ts" }
  ],
  "crons": [
    { "path": "/api/v1/cron/invite-drain", "schedule": "0 3 * * *" }
  ]
}
